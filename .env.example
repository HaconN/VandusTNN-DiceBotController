# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Discord bot token (from the Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=your-bot-token-here

# Path to the Google service account JSON key file used to access the sheet
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# The Google Sheet name or URL/key that holds the character database
GOOGLE_SHEET_NAME=your-sheet-name-or-key-here
